      "tags": ["boundary", "max-cup"],
      "notes": "diff=13.3 → round 13 → J. Exceeds Latched max HH — should flag out-of-range."
    },
    {
      "id": "LT-006",
      "description": "Extreme cup — K range (75/115)",
      "input": { "underbust_cm": 75, "overbust_cm": 115 },
