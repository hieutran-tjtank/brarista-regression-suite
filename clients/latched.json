  "test_cases": [
    {
      "id": "LT-001",
      "description": "Standard nursing bra — 80/95",
      "input": { "underbust_cm": 80, "overbust_cm": 95 },
      "expected": { "band": 32, "cup": "DD", "full_size": "32DD" },
      "tags": ["standard", "smoke"],
      "notes": "80cm=31.5\" → band 32, 95cm=37.4\", diff=5.4 → round 5 → DD"
    },
    {
      "id": "LT-002",
      "description": "Lower band — 70/85",
      "input": { "underbust_cm": 70, "overbust_cm": 85 },
      "expected": { "band": 28, "cup": "DD", "full_size": "28DD" },
      "tags": ["boundary"],
      "notes": "Band 28 below Latched min (30). Engine calculates correctly, range check is separate."
    },
    {
      "id": "LT-003",
      "description": "Upper band — 105/120",
      "input": { "underbust_cm": 105, "overbust_cm": 120 },
      "expected": { "band": 42, "cup": "DD", "full_size": "42DD" },
      "tags": ["boundary", "large-band"]
    },
    {
      "id": "LT-004",
      "description": "Large cup — G range (75/100)",
      "input": { "underbust_cm": 75, "overbust_cm": 100 },
      "expected": { "band": 30, "cup": "G", "full_size": "30G" },
      "tags": ["large-cup"],
      "notes": "75cm=29.5\" → band 30, 100cm=39.4\", diff=9.4 → round 9 → G"
    },
    {
      "id": "LT-005",
      "description": "Very large cup — J range (80/115)",
      "input": { "underbust_cm": 80, "overbust_cm": 115 },
