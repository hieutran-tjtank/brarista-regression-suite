      "tags": ["maternity", "standard"]
    },
    {
      "id": "LT-008",
      "description": "Recalibration — 85/100, dress UK 14",
      "input": { "underbust_cm": 85, "overbust_cm": 100, "dress_size": "UK 14" },
      "expected": { "band": 34, "cup": "DD", "full_size": "34DD" },
